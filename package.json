{
  "name": "krysky-doma",
  "private": true,
  "version": "1.0.0",
  "description": "Крыски дома — уютная 3D-игра про декоративных крыс (Three.js + React + Capacitor)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc --noEmit",
